# Credenciales de la Spotify App (compartidas para todos los hosts)
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# URL pública del servidor (requerida en producción)
# En Render: https://tu-app.onrender.com
# En local: no es necesaria (usa http://127.0.0.1:3000 por defecto)
APP_URL=https://tu-app.onrender.com

# Puerto (Render lo setea automáticamente, no hace falta tocarlo)
# PORT=3000

# Playlist por defecto para /api/random-track (opcional)
# SPOTIFY_PLAYLIST_ID=37i9dQZF1DXcBWIGoYBM5M
